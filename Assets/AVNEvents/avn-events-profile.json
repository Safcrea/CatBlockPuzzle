    "moves_unit": "hearts",
    "level_extras": {
      "CHAPTER": "int, 1-based chapter of the level (10 levels per chapter)",
      "DIFFICULTY": "int, the level's authored difficulty",
      "IS_LOOP": "int 0/1, an endless-mode level past the 100 authored ones",
      "IS_REPLAY": "int 0/1, the level was already cleared before this attempt",
      "PIECES": "int, cats the level gives the player (excluding spares)"
    }
  },
  "events": {
    "LEVEL_ANALYSIS": {
      "Started": {
        "status": "done",
        "where": "LevelFlowController.ReportAvnLevelStarted; includes mechanics, spares, blocked tiles, drop limit and original start source"
      },
      "Completed": {
        "status": "done",
        "where": "LevelFlowController.CheckWin"
      },
      "Failed": {
        "status": "done",
        "where": "LevelFlowController.FailLevel"
      },
      "Skipped": {
        "status": "done",
        "where": "LevelFlowController.SkipCurrentLevel"
      },
      "Restarted": {
        "status": "done",
        "where": "LevelFlowController.ResetLevel"
      },
      "Left": {
        "status": "done",
        "where": "GameSystem.GoHome; AvnEvents.AppQuitting; AvnEvents.AppLaunch (Killed, recovered)"
      },
      "Choice": {
        "status": "done",
        "where": "MetaProgressionController.LoadNextLevelThroughMetaGate (Next); LevelFlowController.ResetLevel (Restart); GameSystem.GoHome (Home); LevelCompleteScreen.ClaimDoubleCoins (DoubleReward); LevelFlowController.SkipCurrentLevel (Next); AvnEvents.AppLaunch/AppQuitting (Abandoned)"
      }
    },
    "AD_ANALYSIS": {
      "Show": {
        "status": "done",
        "where": "RewardedAds.Show, only after the provider accepts (USE_AVNADS_PLUGIN only); wrapper acceptance, not an impression callback"
      },
      "Closed": {
        "status": "done",
        "where": "RewardedAds.Show Report callback (USE_AVNADS_PLUGIN only)"
      },
      "Failed": {
        "status": "done",
        "where": "RewardedAds.Show Report callback (NotReady); AvnAds.TimedOut (Timeout)"
      }
    },
    "ECONOMY_ANALYSIS": {
      "Earned": {
        "status": "done",
        "where": "MetaProgressionController.RecordMetaFirstClear; LevelFlowController.WinSequence; LevelCompleteScreen.ClaimDoubleCoins; DailyRewardScreen.ReportClaim; PowerUpController.PurchaseBundleFromShop; PowerUpController.GrantCoinsFromShop"
      },
      "Spent": {
        "status": "done",
        "where": "PowerUpController.CompletePurchase; PowerUpController.PurchaseBundleFromShop"
      }
    },
    "APP_ANALYSIS": {
      "Launch": {
        "status": "done",
        "where": "AvnEvents.AppLaunch (AvnRuntime.Launched)"
      },
      "Background": {
        "status": "done",
        "where": "AvnEvents.AppBackground (AvnRuntime.Backgrounded)"
      },
      "Foreground": {
        "status": "done",
        "where": "AvnEvents.AppForeground (AvnRuntime.Foregrounded)"
      }
    },
    "TUTORIAL_ANALYSIS": {
      "Shown": {
        "status": "done",
        "where": "LevelOneTutorial.Begin; PowerUpTutorialManager.Show; MechanicIntroPresenter.Show"
      },
      "Completed": {
        "status": "done",
        "where": "LevelOneTutorial.Finish; PowerUpTutorialManager.Show (tap callback); MechanicIntroPresenter.Show (dismiss callback)"
      },
      "Interrupted": {
        "status": "done",
        "where": "LevelOneTutorial.Cancel; PowerUpTutorialManager.Show/Cancel; MechanicIntroPresenter.Cancel"
      }
    },
    "POWERUP_ANALYSIS": {
      "Obtained": {
        "status": "done",
        "where": "PowerUpController.CompletePurchase; PowerUpController.Grant; PowerUpTutorialManager.Show (unlock grant); DailyRewardScreen.ReportClaim"
      },
      "Used": {
        "status": "done",
        "where": "PowerUpController.ReportUse"
      }
    },
    "SCREEN_ANALYSIS": {
      "Opened": {
        "status": "done",
        "where": "ReferenceUiNavigation pages; PauseMenu/SettingsMenu/NoInternetScreen/ComingSoonPopup on actual show; PowerUpPurchasePopup.Show"
      },
      "Interaction": {
        "status": "done",
        "where": "HomeController; PauseMenu; SettingsMenu; ShopScreen.Awake (offer tap); DailyRewardScreen; PowerUpPurchasePopup"
      },
      "Closed": {
        "status": "done",
        "where": "Page replacement; AvnPopupLifetime on the actual popup root (deduplicated); explicit user dismiss; PowerUpPurchasePopup.OnDisable"
      }
    },
    "IAP_ANALYSIS": {
      "Clicked": {
        "status": "not_applicable",
        "where": ""
      },
      "Purchased": {
        "status": "not_applicable",
        "where": ""
      },
      "Failed": {
        "status": "not_applicable",
        "where": ""
      },
      "SubActivated": {
        "status": "not_applicable",
        "where": ""
      }
    },
    "PLAYER_ANALYSIS": {
      "Snapshot": {
        "status": "done",
        "where": "AvnEvents.PlayerSnapshotForSession (AvnRuntime.NewSession); CatBlockPuzzleGame.Start (save loaded)"
      }
    },
    "DEVICE_ANALYSIS": {
      "Snapshot": {
        "status": "done",
        "where": "AvnEvents.SendDeviceSnapshotIfChanged (on Launch)"
      }
    }
  },
  "not_implemented": [
    {
      "event": "IAP_ANALYSIS",
      "state": "Clicked",
      "reason": "the game has no store integration; shop coin packs are disabled placeholders with no product IDs"
    },
    {
      "event": "IAP_ANALYSIS",
      "state": "Purchased",
      "reason": "the game has no store integration"
    },
    {
      "event": "IAP_ANALYSIS",
      "state": "Failed",
      "reason": "the game has no store integration"
    },
    {
      "event": "IAP_ANALYSIS",
      "state": "SubActivated",
      "reason": "the game has no subscriptions"
    },
    {
      "event": "LEVEL_ANALYSIS",
      "state": "Choice ACTION=Revive",
      "reason": "the game has no revive"
    },
    {
      "event": "AD_ANALYSIS",
      "state": "FORMAT=Interstitial / AppOpen",
      "reason": "the game shows no interstitial or app-open ads"
    }
  ],
  "omitted_params": [
    {
      "event": "LEVEL_ANALYSIS",
      "param": "SKIP_OFFERED",
      "reason": "the Skip button's visibility on result screens is set in the scene, not in code, so it cannot be read reliably"
    },
    {
      "event": "LEVEL_ANALYSIS",
      "param": "LEVEL_TIME / TIME_LEFT",
      "reason": "omitted on levels 1-10, which are untimed by design"
    },
    {
      "event": "LEVEL_ANALYSIS",
      "param": "MOVES_START / MOVES_LEFT",
      "reason": "omitted on levels without mistake hearts"
    },
    {
      "event": "LEVEL_ANALYSIS",
      "param": "METHOD",
      "reason": "sent only on DoubleReward; the game has no revive"
    },
    {
      "event": "AD_ANALYSIS",
      "param": "FALLBACK",
      "reason": "the game has no interstitial fallback"
    },
    {
      "event": "PLAYER_ANALYSIS",
      "param": "HAS_PURCHASED / SUB_ACTIVE / ADS_REMOVED",
      "reason": "no store, subscriptions or remove-ads"
    },
    {
      "event": "DEVICE_ANALYSIS",
      "param": "TIER",
      "reason": "the game has no quality tier of its own"
    }
  ],
  "uncovered_features": [],
  "extensions": {
    "DAILY_PUZZLE_ANALYSIS": {
      "states": [
        "Started",
        "Completed",
        "Failed",
        "Restarted",
        "Left",
        "Choice"
      ],
      "identity": "Separate attempt counter per puzzle date and level; GAME_MODE=daily_puzzle, PUZZLE_DATE=yyyy-MM-dd UTC; recovered exits preserve mode/date. Same payload as campaign. Debug previews remain excluded."
    },
    "LEVEL_ANALYSIS extras": {
      "Started": [
        "MECHANICS",
        "SPARES",
        "BLOCKED_TILES",
        "DROP_LIMIT",
        "START_SOURCE",
        "GAME_MODE"
      ],
      "Completed": [
        "STARS",
        "BEST_STARS",
        "PREVIOUS_BEST_STARS"
      ],
      "Completed/Failed/Restarted/Left/Skipped": [
        "PLACEMENTS",
        "BOARD_MOVES",
        "SHELF_RETURNS",
        "MISDROPS",
        "CANCELLED_DROPS",
        "LOCK_BLOCKED_DROPS",
        "HEARTS_LOST",
        "BEST_COMBO",
        "HINTS_USED",
        "FREE_HINTS_USED",
        "FREEZES_USED",
        "ROTATES_USED",
        "FIRST_MOVE_SECONDS",
        "REACHED_LOW_TIME",
        "DROPS_USED",
        "DROP_LIMIT",
        "DROPS_LEFT",
        "DROPS_OVER_LIMIT"
      ],
      "notes": "Drop fields only on drop-limit levels. MOVES_START/MOVES_LEFT still mean hearts. Recovered kills have only the last persisted core progress/time/hearts snapshot, not all live result extras."
    },
    "GAMEPLAY_ANALYSIS": {
      "BoardAction": [
        "placement",
        "board_move",
        "shelf_return",
        "misdrop",
        "lock_blocked_drop",
        "cancelled_drop"
      ],
      "Hint": [
        "FOUND_TARGET",
        "SOURCE=inventory|fail_streak",
        "COST=0 on a free hint"
      ],
      "MoveTipShown": "Existing move tip hook; free hints do not consume inventory or increment standard inventory-use counts."
    },
    "PROGRESSION_ANALYSIS": {
      "states": [
        "ChapterUnlocked",
        "ChapterGateBlocked",
        "EndlessEntered"
      ],
      "where": "Existing GameAnalytics progression hooks forwarded through AvnEvents.Supplement; legacy event names unchanged"
    },
    "TUTORIAL_PROGRESS_ANALYSIS": {
      "Step": [
        "TUTORIAL",
        "STEP"
      ],
      "where": "Each existing first-level tutorial step hook"
    },
    "PURCHASE_ANALYSIS": {
      "Result": [
        "ITEM",
        "SOURCE=shop|powerup_popup",
        "RESULT=success|insufficient_coins|invalid_offer|inventory_full|unavailable",
        "PRICE_COINS",
        "QUANTITY",
        "BALANCE_COINS",
        "SHORTFALL"
      ],
      "notes": "Coin purchases and testing-only coin grants; never represents real-money store success. No callbacks are fabricated for disabled controls."
    },
    "NAVIGATION_ANALYSIS": {
      "Interaction": [
        "ACTION",
        "SCREEN",
        "TARGET_LEVEL (optional)",
        "PAGE (optional)"
      ],
      "actions": [
        "select_level",
        "play_level",
        "change_page",
        "retry_connected",
        "retry_offline",
        "okay",
        "dismiss",
        "close",
        "next",
        "home",
        "retry",
        "skip",
        "double_reward",
        "notifications_on",
        "notifications_off"
      ],
      "notes": "Result action taps remain distinguishable after standard Choice has been consumed by DoubleReward. Locked disabled level cards do not generate click events."
    },
    "AD_REQUEST_ANALYSIS": {
      "states": [
        "Requested",
        "Accepted",
        "Result"
      ],
      "fields": [
        "REQUEST_ID",
        "PLACEMENT",
        "OUTCOME",
        "SIMULATED"
      ],
      "outcomes": [
        "rewarded",
        "unavailable",
        "cancelled",
        "request_pending",
        "timeout"
      ],
      "notes": "Every request, including builds without the ads SDK, is recorded. Simulations never send real AD_ANALYSIS Show/Closed. Real provider calls handle synchronous callbacks, rejection, exceptions, timeout and late/duplicate callbacks."
    },
    "attempt_clock": "Counts only active gameplay; excludes pause/settings/purchase/tutorial/meta menus, navigation, app background and full-screen ads. In-level input-return animations still count."
  }
}
