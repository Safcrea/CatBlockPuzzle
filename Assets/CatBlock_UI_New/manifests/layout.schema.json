{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Cat Blocks V3.2 delivered dual-contract layout",
  "type": "object",
  "required": [
    "schema_version",
    "screen_id",
    "screen_kind",
    "reference_image",
    "reference_size_px",
    "reference_transform",
    "canvas_px",
    "sort_order",
    "objects",
    "popup_action_button_groups",
    "schemaVersion",
    "assets",
    "elements"
  ],
  "properties": {
    "schema_version": {
      "const": "3.2"
    },
    "screen_kind": {
      "enum": [
        "full_screen",
        "popup"
      ]
    },
    "schemaVersion": {
      "const": 1
    },
    "objects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "instance_id",
          "kind",
          "parent_id",
          "order",
          "enabled_by_default",
          "rect_px",
          "anchor_min",
          "anchor_max",
          "pivot",
          "verified"
        ],
        "properties": {
          "instance_id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "sprite",
              "text",
              "runtime_anchor",
              "overlay"
            ]
          },
          "rect_px": {
            "$ref": "#/$defs/rect"
          },
          "category": {
            "enum": [
              "btns",
              "bars",
              "icons",
              "titles",
              "popups",
              "BG",
              "cards",
              "branding"
            ]
          },
          "asset_path": {
            "type": "string",
            "pattern": "^UI/(btns|bars|icons|titles|popups|BG|cards|branding)/[A-Za-z0-9_]+\\.png$"
          },
          "enabled_by_default": {
            "type": "boolean"
          },
          "order": {
            "type": "integer"
          },
          "verified": {
            "type": "boolean"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "sprite"
                }
              }
            },
            "then": {
              "required": [
                "asset_id",
                "asset_path",
                "native_size_px",
                "alpha_bounds_px",
                "category"
              ]
            }
          }
        ]
      }
    }
  },
  "$defs": {
    "rect": {
      "type": "object",
      "required": [
        "x",
        "y",
        "width",
        "height"
      ],
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "width": {
          "type": "number"
        },
        "height": {
          "type": "number"
        }
      }
    }
  }
}
